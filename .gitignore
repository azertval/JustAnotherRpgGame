# Doxygen lancé depuis la racine (au lieu de Documentation/, cf.
# scripts/docs/build_docs.py) y crée un `generated/` parasite : l'ignorer plutôt que
# de le versionner par accident.
/generated/

# --- Couverture de code ---
coverage.xml
coverage-html/
*.cov

# --- Corpus source (LOT-30, EX-CNT-023) ---
# Les huit PDF de référence, plus les neuf ressources de table virtuelle ajoutées le 2026-09-07
# (cartes, jetons, compendium) : environ 1 600 pages et 785 Mo, dont deux images de plus de 100 Mo.
# Git les versionne mal — chaque clone les traîne, et aucune révision ne se compresse. Ils se
# déposent à la main sur le poste qui en a besoin ; `scripts/sourcebook/corpus.toml` en porte
# l'empreinte, et c'est LUI qui est versionné, avec l'outil qui le lit.
# Rien de ce dossier n'est versionné, pas même un fichier texte : ne rien y écrire d'unique.
Documentation/SourceBook/

# Le corpus texte intermédiaire produit par l'extraction n'est pas versionné non plus : il se
# régénère à la demande depuis les PDF locaux. Ce sont les DONNÉES FINALES qui entrent dans le
# dépôt. Emplacement conventionnel du cache de `python scripts/sourcebook --cache …`.
/.cache/

# --- Outillage d'agent (worktrees et sessions, hors du dépôt) ---
# `.claude/worktrees/` porte des copies complètes du dépôt : 1,6 Go sur ce poste. Les réglages
# éventuels de `.claude/` restent versionnables, eux.
/.claude/worktrees/
/.claude/jobs/

# --- Divers ---
*.log
*.tmp
Thumbs.db
Desktop.ini
__pycache__/
*.pyc
# Environnement Python des scripts, recréé par `uv sync --locked` (phase 4).
.venv/
.pytest_cache/
# Rapports JUnit que les jobs de CI écrivent à la racine (pytest, ctest).
/test-results/

# Module QML de developpement, ENGENDRE a la configuration (LOT-86). Il rend Source/Ui importable
# tel quel -- c'est ce qui permet au .qmlproject de l'artiste de resoudre Jadg.Ui sans connaitre
# le repertoire de construction. Engendre depuis la meme liste que la ressource, jamais edite.
/Source/Ui/Jadg/
# Configuration du serveur de langage QML, engendree par qt_add_qml_module (QT_QML_GENERATE_QMLLS_INI).
.qmlls.ini

# Session de Qt Design Studio : etat LOCAL d'un poste (fenetres ouvertes, cibles de construction,
# identifiant d'environnement de la machine). Rien de partageable, et le versionner ferait diverger
# deux postes a chaque ouverture du projet. `*.user`, le pendant de Qt Creator, est deja couvert
# plus haut.
*.qtds

# Fabrique : répertoire de travail LOCAL de l'auteur -- sources du générateur, commandes,
# descripteurs d'installation, aperçus. Rien n'y est jamais livré (décision de l'auteur, 23
# septembre 2026, qui revient sur l'exception du LOT-104) : le dépôt ne reçoit que l'asset installé.
/Tools/

# Captures du test de parite peintre / GPU (test_scene_painter) : deux images par cadrage, ecrites
# a cote de l'executable pour etre relues a l'oeil. Une sortie de test, regeneree a chaque
# execution -- deja supprimee du depot une fois (PR #91), elle y etait revenue.
/editor-captures/

# Kits d'assets hors de Git (LOT-108) : les images viennent d'archives publiées, installées par
# scripts/fetch_assets.py d'après Source/Elements/Assets/kits.lock.json. Les manifestes JSON et les
# README restent suivis ; seules les images sont ignorées, avec les témoins d'installation.
/Source/Elements/Assets/.kits/
/Source/Elements/Assets/Common/**/*.png
/Source/Elements/Assets/Common/**/*.jpg
/Source/Elements/Assets/Common/**/*.jpeg
/Source/Elements/Assets/Regions/**/*.png
/Source/Elements/Assets/Regions/**/*.jpg
/Source/Elements/Assets/Regions/**/*.jpeg
/Source/Elements/Assets/Maps/**/*.png
/Source/Elements/Assets/Maps/**/*.jpg
/Source/Elements/Assets/Maps/**/*.jpeg
/Source/Elements/Assets/UI/**/*.png
/Source/Elements/Assets/UI/**/*.jpg
/Source/Elements/Assets/UI/**/*.jpeg
