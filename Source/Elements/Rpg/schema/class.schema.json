{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justanotherrpggame.local/rpg/class.schema.json",
  "title": "Classe",
  "description": "Une classe jouable. Sa TABLE DE PROGRESSION est une donnee a part entiere (LOT-84, 31 tables detectees dans le corpus) : une ligne par niveau, jamais une regle en C++. Les ressources declarent ELLES-MEMES leur cadence de recuperation (EX-REG-031), sans quoi chacun des quinze lots de classes modifierait le code du repos, et la quinzieme modification casserait la premiere.",
  "allOf": [
    {
      "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/entree"
    }
  ],
  "type": "object",
  "properties": {
    "id": true,
    "name": true,
    "source": true,
    "status": true,
    "asset": true,
    "mecanismesRequis": true,
    "narratif": true,
    "hitDie": {
      "type": "integer",
      "enum": [
        6,
        8,
        10,
        12
      ]
    },
    "primaryAbility": {
      "type": "array",
      "items": {
        "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/ability"
      },
      "uniqueItems": true
    },
    "savingThrowProficiencies": {
      "type": "array",
      "items": {
        "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/ability"
      },
      "uniqueItems": true,
      "minItems": 2,
      "maxItems": 2
    },
    "subclassLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "armorProficiencies": {
      "type": "array",
      "description": "Categories d'armure maitrisees (LOT-131) : celles de `armor.schema.json`, `shields` compris.",
      "items": {
        "type": "string",
        "enum": [
          "light",
          "medium",
          "heavy",
          "shields"
        ]
      },
      "uniqueItems": true
    },
    "weaponProficiencies": {
      "type": "array",
      "description": "Armes maitrisees (LOT-131) : une categorie (`simple`, `martial`) ou l'identifiant d'une arme du catalogue (`baton`, `rapiere`). Une arme non maitrisee se frappe sans le bonus de maitrise.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "skillChoices": {
      "type": "object",
      "description": "Les competences de classe : un NOMBRE au choix parmi une liste, comme le livre l'ecrit. La fiche dit lesquelles.",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "type": "array",
          "items": {
            "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "count",
        "from"
      ],
      "additionalProperties": false
    },
    "spellcasting": {
      "type": "object",
      "description": "L'INCANTATION SIMPLIFIEE (Player's Guide p. 196, 200 ; LOT-131, EX-RPG-025) : les sorts sont fixes par la table de progression (`spells`, `cantrips`), et chacun se lance `castsPerDay` fois par jour -- pas d'emplacements. DD = 8 + maitrise + modificateur ; attaque = maitrise + modificateur.",
      "properties": {
        "ability": {
          "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/ability"
        },
        "castsPerDay": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "ability",
        "castsPerDay"
      ],
      "additionalProperties": false
    },
    "progression": {
      "type": "array",
      "description": "Une entree par niveau atteint ; les niveaux qui n'apportent rien peuvent etre omis.",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "proficiencyBonus": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          },
          "features": {
            "type": "array",
            "description": "Les capacites que ce niveau apporte : des identifiants de `capacities/` (LOT-131). Une capacite acquise reste, jusqu'a ce qu'une autre la remplace (`replaces`).",
            "items": {
              "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "cantrips": {
            "type": "array",
            "description": "Les sorts mineurs appris a ce niveau (identifiants de `spells/`), a volonte.",
            "items": {
              "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "spells": {
            "type": "array",
            "description": "Les sorts appris a ce niveau (identifiants de `spells/`), chacun lancable `spellcasting.castsPerDay` fois par jour.",
            "items": {
              "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "spellSlots": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": 9
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "level",
          "proficiencyBonus"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://justanotherrpggame.local/rpg/common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "recharge": {
            "type": "string",
            "enum": [
              "short-rest",
              "long-rest",
              "at-will",
              "dawn"
            ],
            "description": "Cadence de recuperation declaree PAR LA RESSOURCE (EX-REG-031) : le mecanisme de repos ne connait aucune classe en particulier."
          }
        },
        "required": [
          "id",
          "name",
          "recharge"
        ],
        "additionalProperties": false
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "source",
    "hitDie",
    "primaryAbility",
    "savingThrowProficiencies"
  ],
  "additionalProperties": false
}
