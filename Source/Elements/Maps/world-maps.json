    "republic-of-freelands-fisherman-s-wharf": {
      "image": "city-republic-of-freelands-fisherman-s-wharf.jpg",
      "sites": [
        {
          "number": 1,
          "name": "The Parliament",
          "note": "The Republic's political core, a grand white marble edifice symbolising peace and hope; it hosts public debates and confidential chambers.",
          "at": [
            0.534,
            0.431
          ]
        },
        {
          "number": 2,
          "name": "Arena of Future",
          "note": "Popular arena of safe, magical, non-lethal bouts and monthly tournaments; an inactive Vandanamalika lies beneath it.",
          "at": [
            0.654,
            0.412
          ]
        },
        {
          "number": 3,
          "name": "Republic Military Fortress",
          "note": "Built atop a natural plateau, it houses magical cannons and the headquarters of the Freelands' military forces.",
          "at": [
            0.404,
            0.375
          ]
        },
        {
          "number": 4,
          "name": "Prime Minister's Palace",
          "note": "Home of the head of government and administrative heart of many ministries; hosts a monthly gala.",
          "at": [
            0.667,
            0.571
          ]
        },
        {
          "number": 5,
          "name": "Celestianist Cathedral of Sun and Moon",
          "note": "The Republic's primary Celestianist temple under High Cardinal Taram, now the administrative heart of the Church.",
          "at": [
            0.486,
            0.834
          ]
        },
        {
          "number": 6,
          "name": "Fisherman's Wharf Port",
          "note": "The Republic's largest and most militarized port; abundant fish and seafood, most trade ships sail to Kolbjörn.",
          "at": [
            0.378,
            0.676
          ]
        },
        {
          "number": 7,
          "name": "Seabreeze District",
          "note": "Serene middle-class enclave of merchants, artisans, fishing ship owners, military officers and bureaucrats.",
          "at": [
            0.418,
            0.748
          ]
        },
        {
          "number": 8,
          "name": "The Six Quarters",
          "note": "Surrounding the Parliament, the city's priciest estates; its sole non-residential structure is the Relic Hunters Guild headquarters.",
          "at": [
            0.529,
            0.356
          ]
        },
        {
          "number": 9,
          "name": "Wallside District",
          "note": "Inhabited by winter elves and eyed with mistrust; Kemet spies hide among them around a concealed temple to Bás.",
          "at": [
            0.411,
            0.231
          ]
        },
        {
          "number": 10,
          "name": "Uptown",
          "note": "Hilly district of diverse shops and estates, with the open market and the Adventurer's Guild headquarters atop a hill.",
          "at": [
            0.66,
            0.335
          ]
        },
        {
          "number": 11,
          "name": "Hope Square",
          "note": "Home to laborers and farming families resettled after the Kemet Invasion; the Academy of Magic stands on its edge; crime is rife.",
          "at": [
            0.593,
            0.714
          ]
        },
        {
          "number": 12,
          "name": "The Cerulean Plaza",
          "note": "The commercial heart, a bustling market of white and blue facades with inns, taverns and the Cerulean Cross Hotel.",
          "at": [
            0.54,
            0.205
          ]
        }
      ]
    }
