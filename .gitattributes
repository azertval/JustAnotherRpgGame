# Normalisation automatique des fins de ligne (LF dans le dépôt).
* text=auto eol=lf

# Scripts Windows : CRLF forcé.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Sources et build.
*.cpp          text
*.h            text
*.hpp          text
*.cmake        text
CMakeLists.txt text
*.json         text
*.yml          text
*.md           text

# Assets binaires (Elements/) — pas de diff, candidats à Git LFS.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.dds binary
*.tga binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
# Maillages (LOT-1003) : glTF binaire.
*.glb binary
*.otf binary
