# Doxyfile minimal — JustAnotherRpgGame
# Génération : depuis Documentation/, exécuter `doxygen Doxyfile`.
# Les options non spécifiées gardent les valeurs par défaut de Doxygen.

PROJECT_NAME           = "JustAnotherRpgGame"
# PROJECT_NUMBER n'est pas écrit ici : scripts/build_docs.py l'injecte depuis project(VERSION)
# du CMakeLists.txt racine (source unique de vérité), sur l'entrée standard de Doxygen. Lancer
# `doxygen Doxyfile` directement (sans passer par le script) produit un numéro vide, pas périmé.
PROJECT_NUMBER         =
PROJECT_BRIEF          = "Jeu de rôle tactique au d20, vue de dessus, en C++/Qt"

OUTPUT_DIRECTORY       = generated
CREATE_SUBDIRS         = NO

# Entrées : documentation Markdown (accueil, spécifications, lots) + code source.
# Les chemins sont relatifs à ce dossier (Documentation/).
INPUT                  = index.md \
                         CahierTest.md \
                         Guide \
                         Specification \
                         Lot \
                         Editeur \
                         Manuel \
                         ../Source
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.h *.hpp *.md
# Exclusions : build, dépendances, sortie générée, et les README de modules de
# Source/ (notes internes, non voulues comme pages du site).
EXCLUDE_PATTERNS       = */build/* */External/* */generated/* */Source/*README.md

# Page d'accueil du site (mainpage) et arbre de navigation latéral.
USE_MDFILE_AS_MAINPAGE = index.md
GENERATE_TREEVIEW      = YES

# Extraction.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
OPTIMIZE_OUTPUT_FOR_C  = NO

# Sorties.
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Verbosité.
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
# Garde-fou qualité (esprit /W4 /WX) : tout avertissement Doxygen (référence
# cassée, @param en conflit, symbole introuvable) fait échouer la génération.
# FAIL_ON_WARNINGS : liste tous les avertissements puis retourne un code non nul.
WARN_AS_ERROR          = FAIL_ON_WARNINGS

# --- Cahier de test (LOT-13, restructure en LOT-20) ---
# \castest{...} : UN seul argument (accolades) -> les virgules du contenu sont autorisees.
# Formate le cas directement dans la doc du test (pas d'agregation via \xrefitem : la page
# "Cahier de test" agregee sur un seul niveau, illisible au-dela de quelques dizaines de cas,
# est desormais reconstruite - structuree par module - par scripts/generate_cahier_test.py
# a partir de ces memes blocs, dans Documentation/CahierTest.md).
# Sous-commandes pour structurer le contenu (categorie, criticite, etapes, resultat attendu).
ALIASES += "castest{1}=<b>Cas de test :</b> \1"
ALIASES += "tcat=<b>Categorie :</b> "
ALIASES += "tcrit=<b>Criticite :</b> "
ALIASES += "tetapes=<b>Etapes :</b><br/>"
ALIASES += "tattendu=<b>Resultat attendu :</b> "
